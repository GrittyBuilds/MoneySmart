# Copy this file to ".env" and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "anon" / public API key (safe to expose in a client app when RLS is enabled)
VITE_SUPABASE_ANON_KEY=
